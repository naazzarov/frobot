# Copy to .env locally. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
FROBOT_DATA_DIR=./data
# Required for non-loopback binding; use at least 32 random characters.
FROBOT_OWNER_TOKEN=
# Enable behind HTTPS. Keep false only for a loopback HTTP development session.
FROBOT_SECURE_COOKIE=false
# Single-process worker concurrency; supported range 1–8.
FROBOT_CONCURRENCY=2
# UTC-day Anthropic request reservations, including uncertain/failed requests.
# These count requests, not billing dollars. Each full AI workflow uses up to 4.
FROBOT_DAILY_MODEL_CALLS=80
FROBOT_COMPANY_DAILY_MODEL_CALLS=40
# Optional: without a key, workflows and exact ledger calculations run locally.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
