# Copy to .env. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
FROBOT_DATA_DIR=./data
# Required when binding to a non-loopback address; use at least 32 random characters.
FROBOT_OWNER_TOKEN=
# Optional: without a key, tasks produce deterministic planning templates.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
